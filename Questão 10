programa {
  funcao inicio() {
    inteiro numero, contador = 1, maior = 0

		
		enquanto(contador <= 5)
		{
			escreva("Digite o ", contador, "º número: ")
			leia(numero)

			
			se(contador == 1)
			{
				maior = numero
			}
			senao
			{
				se(numero > maior)
				{
					maior = numero
				}
			}

			
			contador = contador + 1
		}

		
		escreva("\nO maior valor digitado foi: ", maior)
  }
}
