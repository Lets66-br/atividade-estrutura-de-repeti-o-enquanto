programa {
  funcao inicio() {
    inteiro numero, resultado
    inteiro contador = 1

    escreva("Digite um número para ver a tabuada: ")
    leia(numero)

    escreva("\nTabuada de ", numero, ":\n")

    enquanto(contador<=10){
      resultado = numero * contador

      escreva(numero, " x ", contador, " = ", resultado, "\n")
      
      contador = contador + 1


    }
  }
}
